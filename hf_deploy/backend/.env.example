# AI Video Studio — copy to .env and fill in what you have.
# Everything works with graceful fallbacks when a key is missing.

# Script generation (Gemini). Without it, a built-in template writer is used.
GEMINI_API_KEY=

# Stock footage
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Voice (ElevenLabs optional — Edge-TTS is used by default and needs no key)
ELEVENLABS_API_KEY=

# Optional: background music file mixed quietly under narration
# MUSIC_FILE=/path/to/music.mp3
